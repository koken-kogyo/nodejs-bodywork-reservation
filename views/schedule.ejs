<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width,initial-scale=1">
        <link rel="stylesheet" href="/static/css/style.css">
        <title>掛川整体からだや</title>
        <style>
        :root {
            --col-count: <%= monthlyThursdays.length + 1.5 %>;  /* 行ヘッダー(timeslot)は1.5倍幅 */
            --row-count: <%= timeslots.length + 3 %>;           /* ナビ＋ヘッダー＋テーブルヘッダーの３行 */
        }
        </style>
        <!-- script src="https://cdnjs.cloudflare.com/ajax/libs/dayjs/1.11.10/dayjs.min.js"></script> -->
        <!-- script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script> -->
        <script src="/static/javascript/dayjs/1.11.10/dayjs.min.js"></script>
        <script src="/static/javascript/html2canvas/1.4.1/html2canvas.min.js"></script>
    </head>
    <body>
        <!-- 初期化処理（ユーザー情報） -->
        <% 
            const loggedIn = user != null;
            const isAdmin = user && user.role == "admin";
        %>

        <!-- ナビゲーション -->
        <%- include('partials/header') %>

        <div id="container" class="container">

            <!-- ヘッダー -->
            <h2 class="header-row">
                <div class="nav-buttons">
                    <a href="/ymd/<%= prevmonth %>"><button>前月</button></a>
                    <%= title %>開催
                    <a href="/ymd/<%= nextmonth %>"><button>翌月</button></a>
                </div>
                <input type="hidden" id="prevmonth" name="prevmonth" value="<%= prevmonth %>" />
                <input type="hidden" id="nextmonth" name="nextmonth" value="<%= nextmonth %>" />
                <!-- テストスタブ button onclick="ScreenshotTest()">html2canvas dayjs graphClient.api</button-->
                <% if (!loggedIn) { %>
                <form id="loginForm" action="/login" method="post">
                    <input id="empnoinput" class="empno-input" name="empnoinput" 
                        placeholder="従業員コード" maxlength="7" oninput="inputChange()">
                </form>
                <% } %>
            </h2>



            <!-- PC版：横テーブル -->
            <div id="pc-wrapper">
            <table class="schedule-table">
            <thead>
                <tr>
                    <th></th>
                    <% monthlyThursdays.forEach(day => { %>
                        <th><%= d2mdw(day) %></th>
                    <% }) %>
                </tr>
            </thead>
            <tbody>
            <% for (let i = 0; i < timeslots.length; i++) { %>
                <tr>
                    <th><%= timeslots[i] %></th>
                    <% monthlyThursdays.forEach(day => { %>
                        <% 
                            const r = findResv(day, i); 
                            const today = new Date();
                            const cellDate = new Date(day);   // day は "2026-10-01" の形式
                            // 過去日判定
                            let isPast = cellDate < today &&
                                !(cellDate.toDateString() == today.toDateString());
                            // 当日deadline 判定 (handlers\timeslot.js 関数より)
                            // 1. timeslotが0または1の場合は、deadline==15:10
                            // 2. それ以外は開始時刻の1時間前
                            if (cellDate.toDateString() == today.toDateString())
                            {
                                const deadline = getOneHourBeforeStartTime(cellDate, i);
                                isPast = (new Date() >= deadline);
                            }
                            const isMine = loggedIn && user && user.empno && user.empno === (r ? r.EMPNO : "");
                            const isFullTimeEmployee = loggedIn && user && user.empno &&
                                (user.empno.startsWith('1') || user.empno.startsWith('2') ||
                                user.empno.startsWith("01") || user.empno.startsWith("02"));
                            // 予約枠ロック判定（①と②は同時に予約出来ない）
                            const findr0 = (i == 0 &&
                                today >= new Date(2026, 9, 1) && 
                                today < new Date(2027, 11, 1)) ? findResv(day, 1) : null;
                            const findr1 = (i == 1 &&
                                today >= new Date(2026, 9, 1) && 
                                today < new Date(2027, 11, 1)) ? findResv(day, 0) : null;
                        %>
                        <% if (r) { %>

                            <!-- 社員の予約 -->
                            <% if (isMine && isFullTimeEmployee) { %>
                                <td class="cell mine <%= (isPast) ? 'reserved-fulltime-past' : 'reserved-fulltime' %>"
                                    data-day="<%= day %>"
                                    data-slot="<%= i %>"
                                    data-json='<%- JSON.stringify(r) %>'
                                    onclick="openDetail(this)">
                                    <%= (isAdmin) ? r.EMPNM : '済' %>
                                </td>

                            <!-- 社員以外の予約 -->
                            <% } else if (isMine && !isFullTimeEmployee) { %>
                                <td class="cell mine <%= (isPast) ? 'reserved-other-past' : 'reserved-other' %>"
                                    data-day="<%= day %>"
                                    data-slot="<%= i %>"
                                    data-json='<%- JSON.stringify(r) %>'
                                    onclick="openDetail(this)">
                                    <%= (isAdmin) ? r.EMPNM : '済' %>
                                </td>

                            <!-- 他人の予約 -->
                            <% } else { %>
                                <td class="cell reserved">
                                    <%= (isAdmin) ? r.EMPNM : '済' %>
                                </td>
                            
                            <% } %>

                        <!-- 過去日の空き枠：クリック不可 -->
                        <% } else  if (isPast) { %>
                            <td class="cell empty excluded">
                                －
                            </td>

                        <!-- 予約枠ロック -->
                        <% } else if ((i == 0 && findr0) || (i == 1 && findr1)) { %>
                            <td class="cell empty excluded">
                                －
                            </td>

                        <!-- 未ログイン：クリック不可 -->
                        <% } else if (!loggedIn) { %>
                            <td class="cell"
                                onclick="javascript:alert('ログイン後に予約を行って下さい．')">
                                ◯
                            </td>

                        <!-- 空き枠（予約可） -->
                        <% } else { %>
                            <td class="cell empty reserve-ok"
                                data-day="<%= day %>"
                                data-slot="<%= i %>"
                                onclick="openNotice(this)">
                                ◯
                            </td>

                        <% } %>
                    <% }) %>
                </tr>
            <% } %>
            </tbody>
            </table>
            </div>



            <!-- スマホ版：縦積みカード形式 -->
            <div id="sp-wrapper">
            <div class="sp-cards">
            <%
                // monthlyThursdays は "2026-10-01" のような文字列なので
                // Date に変換して降順ソートする
                const sortedDays = [...monthlyThursdays].sort((a, b) => {
                    return new Date(b) - new Date(a);   // 新しい日付が先
                });
            %>
            <% sortedDays.forEach(day => { %>
                <div class="day-card">
                <div class="day-title"><%= d2mdw(day) %></div>
                <% for (let i = 0; i < timeslots.length; i++) { %>
                    <% 
                        const r = findResv(day, i);
                        const today = new Date();
                        const cellDate = new Date(day);
                        let isPast = cellDate < today &&
                            !(cellDate.toDateString() == today.toDateString());
                        // 当日deadline 判定 (handlers\timeslot.js 関数より)
                        // 1. timeslotが0または1の場合は、deadline==15:10
                        // 2. それ以外は開始時刻の1時間前
                        if (cellDate.toDateString() == today.toDateString())
                        {
                            const deadline = getOneHourBeforeStartTime(cellDate, i);
                            isPast = (new Date() >= deadline);
                        }
                        const isMine = loggedIn && user && user.empno && user.empno === (r ? r.EMPNO : "");
                        const isFullTimeEmployee = loggedIn && user && user.empno &&
                            (user.empno.startsWith('1') || user.empno.startsWith('2') ||
                            user.empno.startsWith("01") || user.empno.startsWith("02"));
                        // 予約枠ロック判定（①と②は同時に予約出来ない）
                        const findr0 = (i == 0 &&
                            today >= new Date(2026, 9, 1) && 
                            today < new Date(2027, 11, 1)) ? findResv(day, 1) : null;
                        const findr1 = (i == 1 &&
                            today >= new Date(2026, 9, 1) && 
                            today < new Date(2027, 11, 1)) ? findResv(day, 0) : null;
                    %>
                    <% if (r) { %>

                        <!-- 社員の予約 -->
                        <% if (isMine && isFullTimeEmployee) { %>
                            <div class="slot-card mine <%= (isPast) ? 'reserved-fulltime-past' : 'reserved-fulltime' %>"
                                data-day="<%= day %>"
                                data-slot="<%= i %>"
                                data-json='<%- JSON.stringify(r) %>'
                                onclick="openDetail(this)">
                                <div class="slot-time">
                                    <%= timeslots[i] %>
                                    <%= (isPast) ? '（施術済）' : '（予約済）' %>
                                </div>
                            </div>

                        <!-- 社員以外の予約 -->
                        <% } else if (isMine && !isFullTimeEmployee) { %>
                            <div class="slot-card mine <%= (isPast) ? 'reserved-other-past' : 'reserved-other' %>"
                                data-day="<%= day %>"
                                data-slot="<%= i %>"
                                data-json='<%- JSON.stringify(r) %>'
                                onclick="openDetail(this)">
                                <div class="slot-time">
                                    <%= timeslots[i] %>
                                    <%= (isPast) ? '（施術済）' : '（予約済）' %>
                                </div>
                            </div>

                        <!-- 他人の予約 -->
                        <% } else { %>
                            <div class="slot-card reserved"
                                data-day="<%= day %>"
                                data-slot="<%= i %>">
                                <div class="slot-time">
                                    <%= timeslots[i] %>
                                    <%= (isPast) ? '（施術済）' : '（予約あり）' %>
                                </div>
                            </div>

                        <% } %>

                    <!-- 過去日の空き枠（クリック不可） -->
                    <% } else if (isPast) { %>
                        <div class="slot-card excluded">
                            <div class="slot-time">
                                <%= timeslots[i] %>
                                　－
                            </div>
                        </div>

                    <!-- 予約枠ロック -->
                    <% } else if ((i == 0 && findr0) || (i == 1 && findr1)) { %>
                        <div class="slot-card excluded">
                            <div class="slot-time">
                                <%= timeslots[i] %>
                                　－
                            </div>
                        </div>

                    <!-- 未ログイン（クリック不可） -->
                    <% } else if (!loggedIn) { %>
                        <div class="slot-card empty"
                            onclick="javascript:alert('ログイン後に予約を行って下さい．')">
                            <div class="slot-time">
                                <%= timeslots[i] %>
                                　◯
                            </div>
                        </div>

                    <!-- 空き枠（予約可） -->
                    <% } else { %>
                        <div class="slot-card empty"
                            data-day="<%= day %>"
                            data-slot="<%= i %>"
                            onclick="openReserveDirect(this)">
                            <div class="slot-time">
                                <%= timeslots[i] %>
                                　◯
                            </div>
                        </div>

                    <% } %>
                <% } %>
                </div>
            <% }) %>
            </div>
            </div>




            <!-- お知らせポップアップ画面 -->
            <div id="notice-modal" class="modal">
            <div class="notice-modal-content">
                <h3>お知らせ</h3>
                <p>施術30分<br>自己負担額1,500円でご利用いただけます。</p>

                <div class="notice-buttons">
                    <button onclick="closeNotice()">閉じる</button>
                    <button onclick="openReserve()" class="primary">了解しました</button>
                </div>
            </div>
            </div>



            <!-- 予約画面 -->
            <div id="reserve-modal" class="modal">
            <div class="reserve-modal-content">
                <h3>予約画面</h3>

                <div class="reserve-row">
                    <label class="reserve-label">日付：</label>
                    <div id="reserve-date" class="reserve-value"></div>
                </div>
                <div class="reserve-row">
                    <label class="reserve-label">時間：</label>
                    <div id="reserve-timeslot-name" class="reserve-value"></div>
                </div>
                <label>施術内容:</label>
                <select id="reserve-treatment">
                    <option>腰痛</option>
                    <option>肩凝り</option>
                    <option>頭痛</option>
                    <option>股関節痛</option>
                    <option>膝痛</option>
                    <option>自律神経の不調</option>
                    <option>その他</option>
                </select>
                <div class="reserve-group">
                    <label for="reserve-note">その他お悩み事:</label>
                    <textarea id="reserve-note" name="note" rows="4"
                        placeholder="肩こり、腰痛、疲労、気になる症状など自由にご記入ください"></textarea>
                </div>
                <input type="hidden" id="reserve-timeslot" name="reserve-timeslot" value="" />
                <input type="hidden" id="reserve-empno" name="reserve-empno" 
                    value="<%= (loggedIn && user && user.empno) ? user.empno : '' %>" />
                <input type="hidden" id="reserve-name" name="reserve-name"
                    value="<%= (loggedIn && user && user.empno) ? user.name : '' %>" />
                <div class="reserve-buttons">
                    <button onclick="closeReserve()">閉じる</button>
                    <button id="reserve-cancel-button" onclick="reserveCancel()">取消</button>
                    <button id="reserve-button" onclick="reserve()">予約</button>
                </div>
            </div>
            </div>



        </div>
        <script src="/static/javascript/reservation.js"></script>

    </body>
</html>
